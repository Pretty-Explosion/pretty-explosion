# Public site origin for metadata, Open Graph, canonicals, sitemap, and robots.
# Defaults to https://prettyexplosion.com when unset.
# NEXT_PUBLIC_SITE_URL=https://prettyexplosion.com

# Server-only. Create a key at https://resend.com/api-keys after signing up
# with prettyxplosion@gmail.com. Never commit the real value, and do not
# prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=

# Optional. Defaults to prettyxplosion@gmail.com.
# CONTACT_TO_EMAIL=prettyxplosion@gmail.com

# Optional sender. Defaults to "Pretty Explosion <onboarding@resend.dev>",
# which can only deliver to the Resend account email. After prettyexplosion.com
# is verified in Resend, set this and redeploy:
# CONTACT_FROM_EMAIL="Pretty Explosion <hello@prettyexplosion.com>"
